# Токен бота-конструктора, созданного через @BotFather
CONSTRUCTOR_BOT_TOKEN=123456:REPLACE_ME
# Telegram ID владельца платформы, через запятую
OWNER_IDS=123456789
# Максимум персональных ботов на пользователя
MAX_BOTS_PER_USER=3
# Пути относительно каталога проекта (можно оставить значения по умолчанию)
CONSTRUCTOR_DB=data/constructor.sqlite3
INSTANCES_DIR=instances
LOG_LEVEL=INFO
